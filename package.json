{
  "name": "coffee-order-root",
  "private": true,
  "workspaces": [
    "apps/frontend/*",
    "packages/*"
  ],
  "overrides": {
    "follow-redirects": "^1.16.1",
    "form-data": "^4.0.6",
    "nanoid": "^3.3.20",
    "picomatch": "^4.0.7",
    "rollup": "^4.64.8",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "picomatch": "^4.0.7",
    "rollup": "^4.64.8"
  },
  "scripts": {
    "dev:student": "npm run dev -w apps/frontend/Student",
    "dev:admin": "pnpm --dir apps/admin dev",
    "dev:barista": "npm run dev -w apps/frontend/Barista",
    "build": "npm run build --workspaces --if-present",
    "install:all": "npm install"
  }
}
