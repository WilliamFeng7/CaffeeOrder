# Backend environment. Copy to .env next to the server (apps/backend/.env) and edit.
# Real environment variables take precedence over this file.

# JWT signing key (REQUIRED in production). Generate one with:
#   openssl rand -base64 32
# Changing it signs everyone out.
SECRET_KEY=your-super-secret-key-here

# SQLite database. A plain path or the old SQLAlchemy form both work.
# Default: coffee.db next to the server.
# DATABASE_URL=sqlite+aiosqlite:////data/coffee.db

# Token lifetime in minutes (default 10080 = 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Proxies allowed to set X-Forwarded-For (CIDRs or IPs, comma separated).
# FORWARDED_ALLOW_IPS=127.0.0.1

# Extra browser origins for CORS (JSON list or comma separated).
# BACKEND_CORS_ORIGINS=["https://example.com"]
