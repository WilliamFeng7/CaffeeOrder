{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"],
            "@shared/*": ["../../../packages/shared/src/*"]
        }
    },
    "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.vue"]
}
